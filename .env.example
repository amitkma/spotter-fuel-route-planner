# Copy to .env and adjust. Every variable is optional for local development.

# development | staging | production. Anything but "development" loads production.py.
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/spotter   (default: SQLite db.sqlite3)
# REDIS_URL=redis://localhost:6379/0                          (default: in-process cache)

# Routing (OSRM public demo server: free, no key is required)
OSRM_BASE_URL=https://router.project-osrm.org
ROUTE_CACHE_TIMEOUT=86400

# Geocoding fallback for free-text addresses (Nominatim). "City, ST" and "lat,lng" never
# call it.
GEOCODING_ONLINE_FALLBACK=true
NOMINATIM_USER_AGENT=spotter-fuel-route-planner/1.0 (amitkma@example.com)

# Vehicle / planning
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
STATION_CORRIDOR_MILES=10
FUEL_STOP_PENALTY_USD=5
